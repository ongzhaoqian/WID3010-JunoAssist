# Ignore virtual environment folders
.venv/
venv/
env/
backend/.venv/

# Ignore frontend dependencies/build outputs
dashboard/node_modules/
dashboard/dist/
dashboard/.next/

# Ignore Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.pyre/
.pytype/
.python-version

# Ignore local environment variables/secrets
.env

# Ignore editor files
.vscode/
.idea/
*.swp
*~
.DS_Store

# Ignore metadata files
*:Zone.Identifier

# Ignore generated ROS/catkin build folders
build/
devel/
install/
log/
logs/

# Ignore temporary and environment artifacts
*.log
*.sqlite3
*.db
