# Ignore virtual environment folders
.venv/
venv/
env/
backend/.venv/

# Ignore frontend dependencies/build outputs
dashboard/node_modules/
dashboard/dist/
dashboard/.next/

# Ignore Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.pyre/
.pytype/
.python-version

# Ignore local environment variables/secrets
.env

# Ignore editor files
.vscode/
.idea/
*.swp
*~
.DS_Store

# Ignore metadata files
*:Zone.Identifier

# Ignore temporary and environment artifacts
*.log
*.sqlite3
*.db
.vscode/settings.json

# Ignore ROS catkin build artifacts (regenerated by catkin_make on each machine)
build/
devel/
install/
backend/build/
backend/devel/
dashboard/build/
dashboard/devel/
.catkin_workspace
dashboard/.catkin_workspace
# Symlink generated by catkin_init_workspace — points to /opt/ros/noetic/share/catkin/cmake/toplevel.cmake
src/CMakeLists.txt
backend/src/CMakeLists.txt
dashboard/src/CMakeLists.txt

# Ignore downloaded ASR model weights
src/language_pkg/models/