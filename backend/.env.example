# Core backend settings
JUNO_DASHBOARD_URL=http://localhost:5173
JUNO_DATABASE_PATH=juno_assist.db
JUNO_ROBOT_INTERFACE=mock
JUNO_USE_ROS=false

# Optional Hugging Face model integration
# Keep false for lightweight laptop/ROS demo startup. Set true on a machine that
# has installed requirements-llm.txt and has enough RAM/GPU for the model.
JUNO_LLM_ENABLED=false
JUNO_LLM_MODEL_ID=mesolitica/Malaysian-Llama-3.2-3B-Instruct
JUNO_LLM_DEVICE_MAP=auto
JUNO_LLM_TORCH_DTYPE=auto
JUNO_LLM_MAX_NEW_TOKENS=96
JUNO_LLM_MAX_RESPONSE_WORDS=80
JUNO_LLM_TEMPERATURE=0.4
JUNO_LLM_TOP_P=0.9
