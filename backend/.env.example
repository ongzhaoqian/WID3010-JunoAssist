# JUNO Assist backend configuration
JUNO_DASHBOARD_URL=http://localhost:5173
# Dashboard lifecycle controls. On power-off, the frontend receives a close request
# and the backend tries to close/focus the existing dashboard browser window.
JUNO_DASHBOARD_WINDOW_TITLE=JUNO Assist Dashboard
JUNO_DASHBOARD_REUSE_EXISTING=true
JUNO_DASHBOARD_CLOSE_ON_SLEEP=true
# Power-down cleanup terminates configured auxiliary runtime processes while
# excluding roscore/rosmaster/rosout and the current backend process.
JUNO_POWERDOWN_CLEANUP_ENABLED=true
JUNO_POWERDOWN_CLEANUP_DELAY_SECONDS=2.0
JUNO_POWERDOWN_CLEANUP_GRACE_SECONDS=1.0
JUNO_POWERDOWN_CLEANUP_PATTERNS=npm\s+run\s+dev|vite|roslaunch\s+juno_bringup|camera_node\.py|microphone_node\.py|tts_node\.py|transcriber\.py|camera_listener_node\.py|microphone_listener_node\.py
JUNO_POWERDOWN_CLEANUP_EXCLUDE_PATTERNS=roscore|rosmaster|rosout|backend/main\.py|uvicorn.*backend|pytest
JUNO_DATABASE_PATH=juno_assist.db
JUNO_WAKE_PHRASE=hey john
JUNO_CONFIRMATION_PHRASE=yes
JUNO_EMOTION_UPDATE_SECONDS=3.0
# Explicit speech emotion cues override camera emotion for this many seconds.
JUNO_SPEECH_EMOTION_OVERRIDE_SECONDS=45.0

# Use mock mode on a laptop, or ros on the Jupiter/ROS machine.
JUNO_ROBOT_INTERFACE=mock
# JUNO_ROBOT_INTERFACE=ros

# Robot-friendly ASR settings. The ROS language node uses openai/whisper-tiny
# to transcribe /audio/raw and publish text to /speech/transcript.
JUNO_ASR_ENABLED=true
JUNO_ASR_MODEL_ID=openai/whisper-tiny
# translate = non-English speech is translated to English; transcribe = same-language transcript.
JUNO_ASR_TASK=translate
# Leave blank for Whisper auto-detection. Examples: english, malay, chinese, tamil.
JUNO_ASR_LANGUAGE=
JUNO_ASR_SAMPLE_RATE=16000
JUNO_ASR_WINDOW_SECONDS=3.0
JUNO_ASR_MIN_RMS=0.03
# -1 = CPU, 0 = first CUDA GPU, mps = Apple Silicon MPS if supported by local stack.
JUNO_ASR_DEVICE=-1
# Delay before STT resumes after /juno/tts_done to avoid capturing speaker tail audio.
JUNO_ASR_TTS_RESUME_DELAY=0.5

# Optional text-generation LLM settings. Disabled by default because the robot
# target cannot reliably run Malaysian Llama + LoRA locally.
JUNO_LLM_ENABLED=false
JUNO_LLM_MODEL_ID=
JUNO_LLM_ADAPTER_ID=
JUNO_LLM_DEVICE_MAP=auto
JUNO_LLM_TORCH_DTYPE=auto
JUNO_LLM_MAX_NEW_TOKENS=96
JUNO_LLM_NORMALISE_MAX_NEW_TOKENS=48
JUNO_LLM_MAX_RESPONSE_WORDS=80
JUNO_LLM_TEMPERATURE=0.3
JUNO_LLM_TOP_P=0.9

# ROS transcript topic settings.
# /speech/raw_transcript remains available for manual/external ASR fallback.
JUNO_TRANSCRIBER_INPUT_TOPIC=/speech/raw_transcript
JUNO_TRANSCRIBER_OUTPUT_TOPIC=/speech/transcript

# Camera stream settings. The backend subscribes to /camera/image_raw and exposes
# it to the dashboard as an MJPEG stream, so the camera appears inside the web UI
# instead of a separate OpenCV pop-up window.
JUNO_CAMERA_TOPIC=/camera/image_raw
JUNO_CAMERA_STREAM_FPS=12
JUNO_CAMERA_JPEG_QUALITY=80
# Keep both false so users decide from the dashboard on first load.
JUNO_CAMERA_ENABLED_DEFAULT=false
JUNO_VISION_MODEL_ENABLED_DEFAULT=false

# Core Vision Module settings. The default backend uses one lightweight facial
# expression image classifier. The dashboard can display the same internal
# evidence as either JUNO mode or Ekman mode without reloading the model.
JUNO_VISION_BACKEND=face_expression
JUNO_VISION_MODEL_ID=mo-thecreator/vit-Facial-Expression-Recognition
JUNO_VISION_EMOTION_MODE_DEFAULT=juno
# Optional comma-separated label order only for models with numeric labels.
JUNO_VISION_LABEL_ORDER=
# auto chooses CUDA, Apple MPS, then CPU. Use cpu only if you want CPU explicitly.
JUNO_VISION_DEVICE=auto
JUNO_VISION_MAX_NEW_TOKENS=96
JUNO_VISION_MIN_CONFIDENCE=0.30
# Treat low-confidence neutral outputs as unknown instead of displaying a fake neutral state.
JUNO_VISION_NEUTRAL_UNCERTAIN_CONFIDENCE=0.45
# Let clear non-neutral classifier outputs update the dashboard immediately.
JUNO_VISION_FAST_SWITCH_CONFIDENCE=0.52
# Set true if you prefer unknown when no face is detected; false uses a centre-crop fallback.
JUNO_VISION_REQUIRE_FACE=false

# Microphone settings. The robot setup in the anas branch used device index 7.
# Substring match for mic device name (preferred over JUNO_MIC_DEVICE_INDEX)
JUNO_MIC_DEVICE_NAME=
JUNO_MIC_DEVICE_INDEX=7
JUNO_MIC_SOURCE_RATE=48000
JUNO_MIC_CHUNK_SIZE=1024
JUNO_MIC_CHANNELS=1


# Emotion-aware music settings.
# The dashboard renders Spotify embeds by default. Replace any playlist URL below
# with your preferred Spotify playlist, album, track, or embed URL.
JUNO_MUSIC_PROVIDER=spotify
JUNO_SPOTIFY_HAPPINESS_URL=https://open.spotify.com/playlist/37i9dQZF1DXdPec7aLTmlC
JUNO_SPOTIFY_NEUTRAL_URL=https://open.spotify.com/playlist/37i9dQZF1DWZeKCadgRdKQ
JUNO_SPOTIFY_SADNESS_URL=https://open.spotify.com/playlist/37i9dQZF1DX4sWSpwq3LiO
JUNO_SPOTIFY_FEAR_URL=https://open.spotify.com/playlist/37i9dQZF1DWWQRwui0ExPn
JUNO_SPOTIFY_ANGER_URL=https://open.spotify.com/playlist/37i9dQZF1DX4WYpdgoIcn6
JUNO_SPOTIFY_DISGUST_URL=https://open.spotify.com/playlist/37i9dQZF1DWZeKCadgRdKQ
JUNO_SPOTIFY_SURPRISE_URL=https://open.spotify.com/playlist/37i9dQZF1DX4WYpdgoIcn6
JUNO_SPOTIFY_UNKNOWN_URL=https://open.spotify.com/playlist/37i9dQZF1DWZeKCadgRdKQ

# TTS settings.
# ROS topics used by the backend publisher and ROS TTS node.
JUNO_TTS_TOPIC=/juno/tts
JUNO_TTS_STOP_TOPIC=/juno/tts_stop
JUNO_LED_TOPIC=/juno/led_state
# Wait/retry settings prevent the first spoken response from being dropped if
# the backend publishes before the TTS subscriber is fully connected.
JUNO_TTS_PUBLISHER_WAIT_SECONDS=2.0
JUNO_TTS_PUBLISH_RETRIES=1
JUNO_TTS_PUBLISH_RETRY_DELAY=0.15
# Voice/runtime settings for src/language_pkg/scripts/tts_node.py.
JUNO_TTS_VOICE_LOCALE=en_GB
JUNO_TTS_RATE=165
JUNO_TTS_DONE_DELAY=1.0
JUNO_TTS_BACKEND=auto
JUNO_TTS_COMMAND=auto
