<launch>
  <!-- Camera and microphone publishers from the attached Jupiter Robot code. -->
  <node pkg="perception_pkg" type="camera_node.py" name="camera_node" output="screen">
    <param name="camera_device" value="/dev/video2" />
  </node>

  <node pkg="perception_pkg" type="microphone_node.py" name="microphone_node" output="screen" />

  <!-- Speech-to-text: publishes recognised speech to /speech/transcript. -->
  <node pkg="language_pkg" type="transcriber.py" name="moonshine_transcriber" output="screen" />

  <!-- Text-to-speech: speaks backend responses from /juno/tts. -->
  <node pkg="language_pkg" type="tts_node.py" name="juno_tts_node" output="screen" />
</launch>
